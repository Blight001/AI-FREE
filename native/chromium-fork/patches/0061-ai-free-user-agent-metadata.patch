Subject: [PATCH] Apply per-profile AI-FREE user-agent metadata


Both renderer and navigation Client Hints use the shared embedder helper.
---
diff --git a/components/embedder_support/user_agent_utils.cc b/components/embedder_support/user_agent_utils.cc
index 608bea5c..2c616a3c 100644
--- a/components/embedder_support/user_agent_utils.cc
+++ b/components/embedder_support/user_agent_utils.cc
@@ -13,9 +13,11 @@
 #include <vector>

 #include "base/android/device_info.h"
+#include "base/base64.h"
 #include "base/command_line.h"
 #include "base/compiler_specific.h"
 #include "base/feature_list.h"
+#include "base/json/json_reader.h"
 #include "base/logging.h"
 #include "base/no_destructor.h"
 #include "base/strings/strcat.h"
@@ -634,7 +636,95 @@ std::string GetPlatformForUAMetadata() {
 #endif
 }

-blink::UserAgentMetadata GetUserAgentMetadata(bool only_low_entropy_ch) {
+namespace {
+
+constexpr char kHsUserAgentMetadata[] = "hs-user-agent-metadata";
+
+blink::UserAgentMetadata ApplyAiFreeUserAgentMetadata(
+    blink::UserAgentMetadata metadata,
+    bool only_low_entropy_ch) {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kHsUserAgentMetadata)) {
+    return metadata;
+  }
+
+  std::string decoded;
+  if (!base::Base64Decode(
+          command_line->GetSwitchValueASCII(kHsUserAgentMetadata),
+          &decoded) ||
+      decoded.size() > 16384) {
+    return metadata;
+  }
+  auto parsed = base::JSONReader::Read(decoded, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return metadata;
+  }
+
+  const base::DictValue& overrides = parsed->GetDict();
+  auto parse_brand_list = [](const base::ListValue* entries) {
+    blink::UserAgentBrandList brands;
+    if (!entries) {
+      return brands;
+    }
+    for (const base::Value& entry : *entries) {
+      if (brands.size() >= 8) {
+        break;
+      }
+      if (!entry.is_dict()) {
+        continue;
+      }
+      const base::DictValue& item = entry.GetDict();
+      const std::string* brand = item.FindString("brand");
+      const std::string* version = item.FindString("version");
+      if (brand && !brand->empty() && version && !version->empty()) {
+        brands.emplace_back(*brand, *version);
+      }
+    }
+    return brands;
+  };
+
+  blink::UserAgentBrandList brands =
+      parse_brand_list(overrides.FindList("brands"));
+  if (!brands.empty()) {
+    metadata.brand_version_list = std::move(brands);
+  }
+  if (std::optional<bool> value = overrides.FindBool("mobile")) {
+    metadata.mobile = *value;
+  }
+  if (const std::string* value = overrides.FindString("platform")) {
+    metadata.platform = *value;
+  }
+  if (only_low_entropy_ch) {
+    return metadata;
+  }
+  blink::UserAgentBrandList full_version_list =
+      parse_brand_list(overrides.FindList("fullVersionList"));
+  if (!full_version_list.empty()) {
+    metadata.brand_full_version_list = std::move(full_version_list);
+  }
+  if (const std::string* value = overrides.FindString("fullVersion")) {
+    metadata.full_version = *value;
+  }
+  if (const std::string* value = overrides.FindString("platformVersion")) {
+    metadata.platform_version = *value;
+  }
+  if (const std::string* value = overrides.FindString("architecture")) {
+    metadata.architecture = *value;
+  }
+  if (const std::string* value = overrides.FindString("model")) {
+    metadata.model = *value;
+  }
+  if (const std::string* value = overrides.FindString("bitness")) {
+    metadata.bitness = *value;
+  }
+  if (std::optional<bool> value = overrides.FindBool("wow64")) {
+    metadata.wow64 = *value;
+  }
+  return metadata;
+}
+
+blink::UserAgentMetadata GetDefaultUserAgentMetadata(
+    bool only_low_entropy_ch) {
   blink::UserAgentMetadata metadata;

   // Low entropy client hints.
@@ -673,6 +763,13 @@ blink::UserAgentMetadata GetUserAgentMetadata(bool only_low_entropy_ch) {
   return metadata;
 }

+}  // namespace
+
+blink::UserAgentMetadata GetUserAgentMetadata(bool only_low_entropy_ch) {
+  return ApplyAiFreeUserAgentMetadata(
+      GetDefaultUserAgentMetadata(only_low_entropy_ch), only_low_entropy_ch);
+}
