+void FillAccountField(content::WebContents* contents,
+                      const base::DictValue& command,
+                      AiFreePageGuard guard,
+                      AiFreeAutomationSuccess success,
+                      AiFreeAutomationFailure failure) {
+  if (!guard || PageChanged(guard)) return FailPageChanged(std::move(failure));
+  const auto* origin = command.FindString("origin");
+  const auto* selector = command.FindString("selector");
+  const auto* value = command.FindString("value");
+  if (!origin || !base::StartsWith(*origin, "https://") || !selector ||
+      selector->empty() || selector->size() > 512 || !value || value->empty() ||
+      value->size() > 4096 ||
+      contents->GetPrimaryMainFrame()->GetLastCommittedOrigin().Serialize() !=
+          *origin) {
+    return Fail(std::move(failure), "ACCOUNT_TARGET_MISMATCH",
+                "Invalid account fill target");
+  }
+  // Main document only. Resolve, validate and fill in one renderer task.
+  // Never focus another element or return the credential in the response.
+  ExecuteIsolated(contents,
+      base::StrCat({R"JS((() => { try { const a=)JS", CommandJson(command), R"JS(;
+        if (location.origin !== a.origin) return false;
+        const matches = document.querySelectorAll(a.selector);
+        if (matches.length !== 1) return false;
+        const field = matches[0];
+        if (!(field instanceof HTMLInputElement) || field.disabled || field.readOnly ||
+            !field.checkVisibility({checkOpacity: true, checkVisibilityCSS: true})) return false;
+        const type = field.type;
+        if (a.field === 'password' ? type !== 'password' : !['text', 'email'].includes(type)) return false;
+        const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set;
+        setter.call(field, a.value);
+        if (field.value !== a.value) return false;
+        field.dispatchEvent(new Event('input', {bubbles: true, composed: true}));
+        field.dispatchEvent(new Event('change', {bubbles: true}));
+        return true;
+      } catch { return false; } })())JS"}),
+      base::BindOnce(
+          [](AiFreePageGuard page_guard, AiFreeAutomationSuccess done,
+             AiFreeAutomationFailure failed, base::Value result) {
+            if (PageChanged(page_guard)) return FailPageChanged(std::move(failed));
+            if (!result.is_bool() || !result.GetBool()) {
+              return Fail(std::move(failed), "ACCOUNT_FILL_FAILED",
+                          "Account field must be unique, visible and editable");
+            }
+            base::DictValue response;
+            response.Set("success", true);
+            response.Set("filled", true);
+            std::move(done).Run(std::move(response));
+          }, std::move(guard), std::move(success), std::move(failure)));
 }
 
