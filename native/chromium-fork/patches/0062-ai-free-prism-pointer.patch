diff --git a/chrome/browser/ui/views/frame/ai_free_pointer_overlay.cc b/chrome/browser/ui/views/frame/ai_free_pointer_overlay.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c8262b33bb87a648680b7343887924b9b19a6216
--- /dev/null
+++ b/chrome/browser/ui/views/frame/ai_free_pointer_overlay.cc
@@ -0,0 +1,298 @@
+// Copyright 2026 AI-FREE Authors. All rights reserved.
+
+#include "chrome/browser/ui/views/frame/ai_free_pointer_overlay.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+#include "base/functional/bind.h"
+#include "cc/paint/paint_flags.h"
+#include "cc/paint/paint_shader.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "third_party/skia/include/core/SkPathBuilder.h"
+#include "third_party/skia/include/core/SkPoint.h"
+#include "third_party/skia/include/core/SkTileMode.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/canvas.h"
+#include "ui/views/view_class_properties.h"
+
+namespace {
+
+constexpr auto kTrailFade = base::Milliseconds(260);
+constexpr auto kPulseDuration = base::Milliseconds(320);
+constexpr float kTrailLength = 65.0f;
+constexpr size_t kTrailSamples = 18;
+constexpr SkColor kWhiteTip = SkColorSetRGB(248, 243, 255);
+constexpr SkColor kViolet = SkColorSetRGB(176, 116, 255);
+constexpr SkColor kBlue = SkColorSetRGB(135, 183, 255);
+constexpr SkColor kCyan = SkColorSetRGB(81, 224, 246);
+constexpr SkColor kInset = SkColorSetRGB(43, 59, 82);
+
+template <size_t N>
+void PaintGradient(gfx::Canvas* canvas,
+                   const SkPath& path,
+                   const SkPoint (&axis)[2],
+                   const std::array<SkColor, N>& colors,
+                   const float* stops = nullptr,
+                   float stroke = 0,
+                   float opacity = 1) {
+  std::array<SkColor4f, N> rgba;
+  std::ranges::transform(colors, rgba.begin(), SkColor4f::FromColor);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  if (stroke > 0) {
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(stroke);
+    flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+  }
+  flags.setAlphaf(opacity);
+  flags.setShader(cc::PaintShader::MakeLinearGradient(
+      axis, rgba.data(), stops, rgba.size(), SkTileMode::kClamp));
+  canvas->DrawPath(path, flags);
+}
+
+template <size_t N>
+void PaintRim(gfx::Canvas* canvas,
+              SkPoint a,
+              SkPoint b,
+              const std::array<SkColor, N>& colors,
+              float scale,
+              const float* stops = nullptr) {
+  const SkPoint axis[] = {a, b};
+  const SkPath edge = SkPathBuilder().moveTo(a).lineTo(b).detach();
+  PaintGradient(canvas, edge, axis, colors, stops, 3.5f * scale, 0.16f);
+  PaintGradient(canvas, edge, axis, colors, stops, 1.5f * scale);
+}
+
+void PaintArrow(gfx::Canvas* canvas, const gfx::PointF& point, bool pressed) {
+  const float scale = pressed ? 0.90f : 1.0f;
+  const SkPoint tip = {point.x(), point.y()};
+  const SkPoint wing = {tip.x() + 21.0f * scale, tip.y() + 12.0f * scale};
+  const SkPoint notch = {tip.x() + 11.9f * scale, tip.y() + 14.6f * scale};
+  const SkPoint heel = {tip.x() + 6.5f * scale, tip.y() + 23.0f * scale};
+  const SkPath shape = SkPathBuilder()
+                           .moveTo(tip)
+                           .lineTo(wing)
+                           .lineTo(notch)
+                           .lineTo(heel)
+                           .close()
+                           .detach();
+  // A dark keyline keeps the white hotspot visible over light pages.
+  cc::PaintFlags keyline;
+  keyline.setAntiAlias(true);
+  keyline.setColor(SkColorSetARGB(184, 49, 37, 78));
+  keyline.setStyle(cc::PaintFlags::kStroke_Style);
+  keyline.setStrokeJoin(cc::PaintFlags::kRound_Join);
+  keyline.setStrokeWidth(2.7f * scale);
+  canvas->DrawPath(shape, keyline);
+  const SkPoint face_axis[] = {tip, {tip.x(), heel.y()}};
+  PaintGradient(canvas, shape, face_axis,
+                std::array{SkColorSetRGB(13, 12, 21), SkColorSetRGB(3, 4, 8)});
+
+  constexpr float kUpperStops[] = {0.0f, 0.58f, 1.0f};
+  PaintRim(canvas, wing, notch, std::array{kBlue, kInset}, scale);
+  PaintRim(canvas, notch, heel, std::array{kInset, kCyan}, scale);
+  PaintRim(canvas, tip, wing, std::array{kWhiteTip, kViolet, kBlue}, scale,
+           kUpperStops);
+  PaintRim(canvas, heel, tip, std::array{kCyan, kWhiteTip}, scale);
+}
+
+void TrimTrail(std::vector<gfx::PointF>& trail) {
+  float remaining = kTrailLength;
+  for (size_t i = trail.size() - 1; i > 0; --i) {
+    const auto segment = trail[i - 1] - trail[i];
+    const float length = segment.Length();
+    if (remaining <= 0.0f) {
+      trail.erase(trail.begin(), trail.begin() + i);
+      break;
+    }
+    if (length > remaining) {
+      const float ratio = remaining / length;
+      trail[i - 1] = trail[i] + gfx::Vector2dF(segment.x() * ratio,
+                                              segment.y() * ratio);
+      trail.erase(trail.begin(), trail.begin() + i - 1);
+      break;
+    }
+    remaining -= length;
+  }
+  if (trail.size() > kTrailSamples) {
+    trail.erase(trail.begin(), trail.end() - kTrailSamples);
+  }
+}
+
+float TrailLength(const std::vector<gfx::PointF>& trail) {
+  float length = 0.0f;
+  for (size_t i = 1; i < trail.size(); ++i) {
+    length += (trail[i] - trail[i - 1]).Length();
+  }
+  return length;
+}
+
+std::vector<SkPoint> TrailEdge(const std::vector<gfx::PointF>& trail,
+                               float length,
+                               float side) {
+  std::vector<SkPoint> edge;
+  edge.reserve(trail.size());
+  float distance = 0;
+  for (size_t i = 0; i < trail.size(); ++i) {
+    const auto& point = trail[i];
+    if (i > 0) {
+      distance += (point - trail[i - 1]).Length();
+    }
+    const auto tangent = trail[std::min(i + 1, trail.size() - 1)] -
+                         trail[i > 0 ? i - 1 : i];
+    const float width =
+        side * 1.28f * std::pow(distance / length, 0.78f) /
+        std::max(0.01f, tangent.Length());
+    edge.push_back({point.x() - tangent.y() * width,
+                    point.y() + tangent.x() * width});
+  }
+  return edge;
+}
+
+void AppendSmoothedEdge(SkPathBuilder& path,
+                        const std::vector<SkPoint>& edge) {
+  for (size_t i = 1; i + 1 < edge.size(); ++i) {
+    const SkPoint midpoint = {(edge[i].x() + edge[i + 1].x()) * 0.5f,
+                              (edge[i].y() + edge[i + 1].y()) * 0.5f};
+    path.quadTo(edge[i], midpoint);
+  }
+  path.lineTo(edge.back());
+}
+
+void PaintTrail(gfx::Canvas* canvas,
+                const std::vector<gfx::PointF>& trail,
+                float opacity) {
+  if (trail.size() < 2 || opacity <= 0) {
+    return;
+  }
+  const float length = TrailLength(trail);
+  if (length < 1.0f) {
+    return;
+  }
+  const auto left = TrailEdge(trail, length, 1.0f);
+  auto right = TrailEdge(trail, length, -1.0f);
+  std::ranges::reverse(right);
+  SkPathBuilder outline;
+  outline.moveTo(left.front());
+  AppendSmoothedEdge(outline, left);
+  outline.lineTo(right.front());
+  AppendSmoothedEdge(outline, right);
+  outline.close();
+
+  const auto& head = trail.back();
+  const auto& tail = (head - trail.front()).Length() > 1.0f
+                         ? trail.front()
+                         : trail[trail.size() - 2];
+  const SkPoint axis[] = {{tail.x(), tail.y()}, {head.x(), head.y()}};
+  PaintGradient(canvas, outline.detach(), axis,
+                std::array{SkColorSetARGB(0, 135, 119, 247),
+                           SkColorSetARGB(100, 142, 112, 247),
+                           SkColorSetARGB(180, 145, 133, 251)},
+                nullptr, 0, opacity);
+}
+
+void PaintPulse(gfx::Canvas* canvas, const gfx::PointF& point, float progress) {
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(1.4f);
+  flags.setColor(SkColorSetARGB(static_cast<U8CPU>(102 * (1.0f - progress)),
+                                154, 129, 251));
+  canvas->DrawCircle(point, 8.0f + 20.0f * progress, flags);
+}
+
+}  // namespace
+
+AiFreePointerOverlay::AiFreePointerOverlay() {
+  SetCanProcessEventsWithinSubtree(false);
+  SetProperty(views::kViewIgnoredByLayoutKey, true);
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+}
+
+AiFreePointerOverlay::~AiFreePointerOverlay() = default;
+
+void AiFreePointerOverlay::SetPointer(const gfx::PointF& point, bool pressed) {
+  RecordMovement(point, base::TimeTicks::Now());
+  point_ = point;
+  pressed_ = pressed;
+  SetVisible(true);
+  SchedulePaint();
+}
+
+void AiFreePointerOverlay::RecordMovement(const gfx::PointF& point,
+                                          base::TimeTicks now) {
+  if (!point_) {
+    return;
+  }
+  if (last_move_.is_null() || now - last_move_ >= kTrailFade) {
+    trail_.assign(1, *point_);
+  }
+  if ((point - trail_.back()).Length() < 0.35f) {
+    return;
+  }
+  trail_.push_back(point);
+  TrimTrail(trail_);
+  last_move_ = now;
+  RequestFrame();
+}
+
+void AiFreePointerOverlay::Pulse() {
+  pulse_started_ = base::TimeTicks::Now();
+  RequestFrame();
+  SchedulePaint();
+}
+
+void AiFreePointerOverlay::ResetEffects() {
+  effect_timer_.Stop();
+  trail_.clear();
+  point_.reset();
+  last_move_ = pulse_started_ = base::TimeTicks();
+  SchedulePaint();
+}
+
+void AiFreePointerOverlay::OnPaint(gfx::Canvas* canvas) {
+  if (!point_) {
+    return;
+  }
+  const auto now = base::TimeTicks::Now();
+  if (!last_move_.is_null()) {
+    const float age = static_cast<float>((now - last_move_) / kTrailFade);
+    PaintTrail(canvas, trail_, std::max(0.0f, 1.0f - age));
+  }
+  if (!pulse_started_.is_null()) {
+    const float progress = static_cast<float>((now - pulse_started_) /
+                                              kPulseDuration);
+    PaintPulse(canvas, *point_, std::clamp(progress, 0.0f, 1.0f));
+  }
+  PaintArrow(canvas, *point_, pressed_);
+}
+
+void AiFreePointerOverlay::RequestFrame() {
+  if (!effect_timer_.IsRunning()) {
+    effect_timer_.Start(FROM_HERE, base::Milliseconds(16),
+                        base::BindRepeating(&AiFreePointerOverlay::TickEffects,
+                                            base::Unretained(this)));
+  }
+}
+
+void AiFreePointerOverlay::TickEffects() {
+  const auto now = base::TimeTicks::Now();
+  if (!last_move_.is_null() && now - last_move_ >= kTrailFade) {
+    last_move_ = base::TimeTicks();
+    trail_.clear();
+  }
+  if (!pulse_started_.is_null() && now - pulse_started_ >= kPulseDuration) {
+    pulse_started_ = base::TimeTicks();
+  }
+  if (last_move_.is_null() && pulse_started_.is_null()) {
+    effect_timer_.Stop();
+  }
+  SchedulePaint();
+}
+
+BEGIN_METADATA(AiFreePointerOverlay)
+END_METADATA
