+// The window owns the observer for the duration of an explicit acquire.
+// Native input and the modal guard are still enabled only on the active tab.
+class AiFreeTakeoverTabs : public TabStripModelObserver {
+ public:
+  explicit AiFreeTakeoverTabs(TabStripModel* tabs) { tabs->AddObserver(this); }
+
+ private:
+  void OnTabStripModelChanged(
+      TabStripModel*, const TabStripModelChange&,
+      const TabStripSelectionChange& selection) override {
+    if (!selection.active_tab_changed()) return;
+    SetPageTakeover(selection.old_contents, false);
+    SetPageTakeover(selection.new_contents, true);
+  }
+};
+
+DEFINE_UI_CLASS_PROPERTY_TYPE(AiFreeTakeoverTabs*)
+
+namespace {
+DEFINE_OWNED_UI_CLASS_PROPERTY_KEY(AiFreeTakeoverTabs, kAiFreeTakeoverTabs)
+}  // namespace
+
+base::DictValue SetAiFreeBrowserTakeover(Browser* browser, bool active) {
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser);
+  auto* tabs = browser->tab_strip_model();
+  auto* contents = tabs->GetActiveWebContents();
+  if (!view) return Status(contents, nullptr, active ? "acquire" : "release");
+  if (active && !view->GetProperty(kAiFreeTakeoverTabs)) {
+    view->SetProperty(kAiFreeTakeoverTabs,
+                      std::make_unique<AiFreeTakeoverTabs>(tabs));
+  } else if (!active) {
+    view->ClearProperty(kAiFreeTakeoverTabs);
+  }
+  SetPageTakeover(contents, active);
+  return Status(contents, contents ? TakeoverSession::FromWebContents(contents)
+                                  : nullptr,
+                active ? "acquire" : "release");
 }
 
 base::DictValue GetAiFreeTakeoverStatus(content::WebContents* web_contents) {
-  return Status(web_contents, TakeoverSession::FromWebContents(web_contents),
+  return Status(web_contents,
+                web_contents ? TakeoverSession::FromWebContents(web_contents)
+                             : nullptr,
                 "status");
 }
 
