   }
+  if (command_name == "set-color-scheme") {
+    const std::string* color_scheme = command.FindString("colorScheme");
+    if (!color_scheme || (*color_scheme != "light" && *color_scheme != "dark")) {
+      return connection->SendErrorAsync(request, command_name,
+                                        "COLOR_SCHEME_INVALID",
+                                        "浏览器主题必须为 light 或 dark");
+    }
+    ThemeService* theme_service =
+        ThemeServiceFactory::GetForProfile(browser->profile());
+    if (!theme_service) {
+      return connection->SendErrorAsync(request, command_name,
+                                        "THEME_SERVICE_UNAVAILABLE",
+                                        "Chromium 浏览器主题服务不可用");
+    }
+    theme_service->SetBrowserColorScheme(
+        *color_scheme == "dark" ? ThemeService::BrowserColorScheme::kDark
+                                 : ThemeService::BrowserColorScheme::kLight);
+    base::DictValue result;
+    result.Set("colorScheme", *color_scheme);
+    return connection->SendSuccessAsync(request, command_name,
+                                        std::move(result));
