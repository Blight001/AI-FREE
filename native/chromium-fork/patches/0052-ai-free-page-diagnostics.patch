+std::string InspectPageDiagnosticsScript() {
+  return R"JS((() => { try {
+  const key='__aiFreeWorkflowPageDiagnosticsV1';
+  const clip=value=>String(value??'').replace(/\s+/g,' ').trim().slice(0,512);
+  const redact=value=>clip(value).replace(/\b(?:token|access[_-]?token|authorization|password|secret)\s*[=:]\s*[^\s,;]+/ig,'[redacted]');
+  const safeUrl=value=>{try{const url=new URL(String(value||''),location.href);return (url.origin+url.pathname).slice(0,512);}catch(_){return '';}};
+  let state=globalThis[key];
+  if(!state){
+    state={cursor:0,events:[],seen:new Set()};
+    const add=(kind,detail={})=>{state.events.push({sequence:++state.cursor,capturedAt:Date.now(),kind,...detail});if(state.events.length>128)state.events.splice(0,state.events.length-128);};
+    window.addEventListener('error',event=>{
+      const target=event.target;
+      if(target&&target!==window){add('request_failure',{message:'资源加载失败',url:safeUrl(target.currentSrc||target.src||target.href),source:String(target.tagName||'').toLowerCase()});return;}
+      add('page_error',{message:redact(event.message||'未捕获脚本异常'),url:safeUrl(event.filename),source:clip(event.lineno?String(event.lineno):'')});
+    },true);
+    window.addEventListener('unhandledrejection',event=>{add('unhandled_rejection',{message:redact(event.reason?.message||event.reason||'未处理 Promise 异常')});});
+    const resource=entry=>{
+      const status=Number(entry.responseStatus||0);if(status<400)return;
+      const id=[entry.name,entry.startTime,status].join('|');if(state.seen.has(id))return;
+      state.seen.add(id);if(state.seen.size>256)state.seen=new Set([...state.seen].slice(-128));
+      add('request_failure',{message:'请求返回失败状态',url:safeUrl(entry.name),status});
+    };
+    try{for(const entry of performance.getEntriesByType('resource'))resource(entry);new PerformanceObserver(list=>{for(const entry of list.getEntries())resource(entry);}).observe({type:'resource',buffered:true});}catch(_){/* Resource Timing is optional. */}
+    globalThis[key]=state;
+  }
+  return {success:true,cursor:state.cursor,events:state.events.slice(-64)};
+} catch(error) {return {success:false,errorCode:'PAGE_DIAGNOSTICS_FAILED',error:String(error.message).slice(0,256)};} })())JS";
+}
+
+// Diagnostics must be installed in the page's main world so page errors
+// and console calls are visible to the persistent diagnostics cursor.
+void ExecuteMainWorld(content::WebContents* web_contents,
+                      std::string script,
+                      base::OnceCallback<void(base::Value)> callback) {
+  web_contents->GetPrimaryMainFrame()->ExecuteJavaScriptForTests(
+      base::UTF8ToUTF16(script), std::move(callback),
+      content::ISOLATED_WORLD_ID_GLOBAL);
+}
