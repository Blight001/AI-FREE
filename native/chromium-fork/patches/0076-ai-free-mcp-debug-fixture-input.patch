+void DebugFixtureInput(content::WebContents* contents,
+                       const base::DictValue& command,
+                       const AiFreePageGuard& page_guard,
+                       AiFreeAutomationSuccess success,
+                       AiFreeAutomationFailure failure) {
+  if (!IsDebugFixture(contents, command, page_guard)) {
+    return Fail(std::move(failure), "MCP_DEBUG_FIXTURE_REQUIRED",
+                "鼠标调试目标必须是当前绑定的 AI-FREE 本地测试页");
+  }
+  auto* frame = contents->GetPrimaryMainFrame();
+  auto* widget = frame->GetRenderWidgetHost();
+  auto* view = widget ? widget->GetView() : nullptr;
+  const auto size = view ? view->GetViewBounds().size() : gfx::Size();
+  if (size.IsEmpty()) {
+    return Fail(std::move(failure), "MCP_DEBUG_VIEWPORT_UNAVAILABLE",
+                "测试页视口不可用");
+  }
+  if (const auto* action = command.FindString("action"); action && *action == "frame") {
+    CaptureScreenshot(contents, base::DictValue(), base::BindOnce(
+        [](AiFreeAutomationSuccess success, gfx::Size size, base::DictValue result) {
+          result.Set("viewWidth", size.width());
+          result.Set("viewHeight", size.height());
+          std::move(success).Run(std::move(result));
+        }, std::move(success), size), std::move(failure), page_guard);
+    return;
+  }
+  if (!DispatchDebugFixtureMouse(widget, size, command)) {
+    return Fail(std::move(failure), "MCP_DEBUG_INPUT_STALE",
+                "鼠标数据无效或视口已变化");
+  }
+  base::DictValue result;
+  result.Set("success", true);
+  std::move(success).Run(std::move(result));
+}
