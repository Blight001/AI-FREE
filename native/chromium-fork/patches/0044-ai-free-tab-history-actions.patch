+      const int previous_count = tab_strip->count();
+      tab_strip->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE |
+                                          TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+      result.Set("count", tab_strip->count());
+      result.Set("closed", tab_strip->count() < previous_count);
+      result.Set("activeTabId", base::NumberToString(tab_strip->active_index()));
+      connection->SendSuccessAsync(request, command_name, std::move(result));
+      return;
+    }
+    const bool back = command_name == "history-back";
