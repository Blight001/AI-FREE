+      return connection->SendErrorAsync(request, command_name, "HISTORY_UNAVAILABLE",
+                                        "目标标签没有相应方向的历史记录");
+    }
+    new NavigationResponseObserver(connection, target, request, command_name);
+    if (back) target->GetController().GoBack();
+    else target->GetController().GoForward();
+    return;
