+      base::DictValue result;
+      result.Set("success", true);
+      result.Set("action", "close");
+      result.Set("closedIndex", index);
+      if (tab_strip->count() == 1) {
+        result.Set("accepted", true);
+        result.Set("browserWillClose", true);
+        base::ThreadPool::PostTaskAndReply(
+            FROM_HERE, {base::MayBlock()},
+            base::BindOnce(&BridgeConnection::SendSuccess, connection, request,
+                           command_name, std::move(result)),
+            base::BindOnce([](base::WeakPtr<Browser> owner) {
+              if (owner && owner->tab_strip_model()->count() == 1)
+                owner->tab_strip_model()->CloseWebContentsAt(
