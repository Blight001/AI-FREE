+base::OnceCallback<void(base::Value)> GuardedDictionaryResult(
+    AiFreePageGuard guard,
+    AiFreeAutomationSuccess success,
+    AiFreeAutomationFailure failure,
+    std::string error_code,
+    std::string error_message) {
+  return base::BindOnce(
+      [](AiFreePageGuard guard, AiFreeAutomationSuccess success,
+         AiFreeAutomationFailure failure, const std::string& code,
+         const std::string& message, base::Value value) {
+        if (PageChanged(guard)) return FailPageChanged(std::move(failure));
+        const base::DictValue* result = value.GetIfDict();
+        if (!result) return Fail(std::move(failure), code, message);
+        std::move(success).Run(result->Clone());
+      }, std::move(guard), std::move(success), std::move(failure),
+      std::move(error_code), std::move(error_message));
+}
