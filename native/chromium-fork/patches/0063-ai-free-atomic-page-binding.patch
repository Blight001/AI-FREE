+std::string PageToken(const BridgeConnection& connection,
+                      content::WebContents* contents) {
+  // Scripts and input must go to a frame endpoint that is not reused by a
+  // subsequent document. Only advertise the capability in that configuration.
+  const auto level = base::GetFieldTrialParamValueByFeature(
+      features::kRenderDocument, "level");
+  if (!base::FeatureList::IsEnabled(features::kRenderDocument) ||
+      (!level.empty() && level != "all-frames") || !contents ||
+      !contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+    return {};
+  }
+  auto* frame = contents->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive() || !frame->IsActive()) return {};
+  return base::StrCat({connection.page_nonce().ToString(), ".",
+                       frame->GetFrameToken().ToString()});
+}
+
+bool IsPageCommand(std::string_view name) {
+  return name == "observe-page" || name == "capture-screenshot" ||
+         name == "perform-action" || name == "download-element" ||
+         name == "automation-takeover" || name == "select-files";
+}
+
+bool IsCurrentPage(scoped_refptr<BridgeConnection> connection,
+                   content::WeakDocumentPtr document) {
+  auto* frame = document.AsRenderFrameHostIfValid();
+  auto* browser = connection->browser().get();
+  const auto* active = browser
+                           ? browser->tab_strip_model()->GetActiveWebContents()
+                           : nullptr;
+  return connection->connected() && frame && active &&
+         active->GetPrimaryMainFrame() == frame && frame->IsRenderFrameLive() &&
+         frame->IsActive();
+}
