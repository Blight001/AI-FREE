+++ b/chrome/browser/ui/ai_free_empty_tab_strip.h
@@ -0,0 +1,19 @@
+#ifndef CHROME_BROWSER_UI_AI_FREE_EMPTY_TAB_STRIP_H_
+#define CHROME_BROWSER_UI_AI_FREE_EMPTY_TAB_STRIP_H_
+
+#include "base/command_line.h"
+#include "chrome/browser/lifetime/browser_shutdown.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/common/chrome_switches.h"
+
+// Applies only to page tab closure, not explicit window or app shutdown.
+inline bool ShouldKeepAiFreeEmptyTabStrip(const Browser& browser) {
+  return browser.is_type_normal() &&
+         base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+             switches::kHsEmbedMode) == "child-window" &&
+         !browser.IsAttemptingToCloseBrowser() &&
+         !browser.IsDeleteScheduled() &&
+         !browser_shutdown::IsTryingToQuit();
+}
+
+#endif  // CHROME_BROWSER_UI_AI_FREE_EMPTY_TAB_STRIP_H_
