 #include "chrome/app/chrome_command_ids.h"
@@ -1465,4 +1468,20 @@
 void Browser::TabStripEmpty() {
+#if BUILDFLAG(IS_WIN)
+  if (ShouldKeepAiFreeEmptyTabStrip(*this)) {
+    // TabStripModel is still notifying observers under its reentrancy guard.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce([](base::WeakPtr<Browser> browser) {
+          if (browser && browser->tab_strip_model()->empty() &&
+              ShouldKeepAiFreeEmptyTabStrip(*browser)) {
+            const GURL url = browser->profile()->IsRegularProfile()
+                                 ? GURL(chrome::kChromeUINewTabPageURL)
+                                 : GURL();
+            chrome::AddTabAt(browser.get(), url, -1, true);
+          }
+        }, AsWeakPtr()));
+    return;
+  }
+#endif
   // Note: even though the tab strip is empty, the call to Close() may not
   // result in closing this Browser. This can happen in the case of closing
   // the last Browser with ongoing downloads.
