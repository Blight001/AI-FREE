+          input.closest('[inert],[aria-disabled="true"]')) return null;
+      for (const target of [input, ...input.labels]) {
+        const label = target !== input;
+        if (label && !target.checkVisibility({opacityProperty:true,visibilityProperty:true})) continue;
+        if (target.closest('[inert],[aria-disabled="true"]')) continue;
+        const rect = target.getBoundingClientRect();
+        const left = Math.max(0, rect.left), right = Math.min(innerWidth, rect.right);
+        const top = Math.max(0, rect.top), bottom = Math.min(innerHeight, rect.bottom);
+        if (right - left < 1 || bottom - top < 1) continue;
+        const x = (left + right) / 2, y = (top + bottom) / 2;
+        const hit = document.elementFromPoint(x, y);
+        if (hit === input) return {x,y};
+        // Interactive descendants (including other inputs) have their own activation behavior.
+        if (label && hit?.closest('label') === target && target.control === input &&
+            !hit.closest('a[href],button,input,select,textarea,summary,[contenteditable="true"]')) {
+          return {x,y};
+        }
+      }
+      return null;
+    }
+)JS";
