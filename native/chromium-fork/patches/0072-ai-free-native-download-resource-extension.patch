+// Chromium evaluates the target extension when protecting insecure downloads.
+// Derive it from the resource resolved by this document, never from a caller's
+// output filename. Chromium still decides whether the download is permitted.
+std::string DownloadResourceExtension(const GURL& url) {
+  const std::string name = url.ExtractFileName();
+  const size_t dot = name.find_last_of('.');
+  if (dot == std::string::npos || name.size() - dot > 17 ||
+      dot + 1 == name.size()) {
+    return {};
+  }
+  const std::string extension = name.substr(dot);
+  if (!std::ranges::all_of(extension.substr(1), [](char value) {
+        return base::IsAsciiAlpha(value) || base::IsAsciiDigit(value);
+      })) {
+    return {};
+  }
+  return extension;
+}
