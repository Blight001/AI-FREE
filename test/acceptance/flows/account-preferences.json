{
  "schemaVersion": 1,
  "id": "account-preferences",
  "domain": "account-preferences",
  "steps": [
    {"id":"openPersonal","use":"openPersonal","args":{},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"initial","use":"inspect","args":{"ready":{"authVisible":true,"closeBehavior":"ask","startupEnabled":false}},"expect":[{"path":"authVisible","op":"equals","value":true},{"path":"confirmVisible","op":"equals","value":false},{"path":"authSubmit","op":"equals","value":"登录"},{"path":"authSwitch","op":"equals","value":"去注册"},{"path":"hasModeArrow","op":"equals","value":true},{"path":"closeBehavior","op":"equals","value":"ask"},{"path":"startupEnabled","op":"equals","value":false},{"path":"settingsOpen","op":"equals","value":false},{"path":"tutorialAbovePersonal","op":"equals","value":true},{"path":"settingsTitle","op":"equals","value":"常规设置"},{"path":"settingsInDialogLayer","op":"equals","value":true},{"path":"settingsAbovePersonal","op":"equals","value":true}]},
    {"id":"leavePersonalForSettings","use":"click","args":{"target":"browsers"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"openSettingsFromRail","use":"click","args":{"target":"settings"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"settingsNavigated","use":"inspect","args":{"ready":{"settingsOpen":true,"personalSelected":true}},"expect":[{"path":"personalSelected","op":"equals","value":true},{"path":"settingsOpen","op":"equals","value":true},{"path":"settingsLarge","op":"equals","value":true}]},
    {"id":"closeSettingsFromRail","use":"click","args":{"target":"closeSettings"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"settingsClosedFromRail","use":"inspect","args":{"ready":{"settingsOpen":false,"personalSelected":true}},"expect":[{"path":"settingsOpen","op":"equals","value":false}]},
    {"id":"showRegistration","use":"click","args":{"target":"authMode"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"registration","use":"inspect","args":{"ready":{}},"expect":[{"path":"confirmVisible","op":"equals","value":true},{"path":"authSubmit","op":"equals","value":"注册并登录"},{"path":"authSwitch","op":"equals","value":"去登录"}]},
    {"id":"showLogin","use":"click","args":{"target":"authMode"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"login","use":"inspect","args":{"ready":{}},"expect":[{"path":"authVisible","op":"equals","value":true},{"path":"confirmVisible","op":"equals","value":false},{"path":"authSubmit","op":"equals","value":"登录"},{"path":"authSwitch","op":"equals","value":"去注册"},{"path":"hasModeArrow","op":"equals","value":true}]},
    {"id":"openSettings","use":"click","args":{"target":"settings"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"settings","use":"inspect","args":{"ready":{}},"expect":[{"path":"settingsOpen","op":"equals","value":true},{"path":"settingsFixedHeight","op":"equals","value":true},{"path":"settingsNoVerticalOverflow","op":"equals","value":true},{"path":"compactCloseOptions","op":"equals","value":true},{"path":"closeBehavior","op":"equals","value":"ask"},{"path":"startupEnabled","op":"equals","value":false}]},
    {"id":"chooseHide","use":"click","args":{"target":"closeToTray"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"hideSaved","use":"inspect","args":{"ready":{"closeSaved":true}},"expect":[{"path":"closeBehavior","op":"equals","value":"hide"},{"path":"closeSaved","op":"equals","value":true}]},
    {"id":"hidePersisted","use":"inspectSaved","args":{},"expect":[{"path":"closeBehavior","op":"equals","value":"hide"},{"path":"openAtLogin","op":"equals","value":false},{"path":"startMinimized","op":"equals","value":false}]},
    {"id":"enableStartup","use":"click","args":{"target":"startup"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"startupSaved","use":"inspect","args":{"ready":{"startupSaved":true}},"expect":[{"path":"startupEnabled","op":"equals","value":true},{"path":"startupSaved","op":"equals","value":true}]},
    {"id":"startupPersisted","use":"inspectSaved","args":{},"expect":[{"path":"closeBehavior","op":"equals","value":"hide"},{"path":"openAtLogin","op":"equals","value":true},{"path":"startMinimized","op":"equals","value":true}]},
    {"id":"reload","use":"reload","args":{},"expect":[{"path":"loaded","op":"equals","value":true}]},
    {"id":"reopenPersonal","use":"openPersonal","args":{},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"reloaded","use":"inspect","args":{"ready":{"closeBehavior":"hide","startupEnabled":true}},"expect":[{"path":"settingsOpen","op":"equals","value":false},{"path":"closeBehavior","op":"equals","value":"hide"},{"path":"startupEnabled","op":"equals","value":true}]}
  ]
}
