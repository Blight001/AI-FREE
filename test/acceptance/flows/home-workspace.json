{
  "schemaVersion": 1,
  "id": "home-workspace",
  "domain": "home-workspace",
  "steps": [
    {"id":"initial","use":"inspect","args":{"ready":{"reservedSidebarWidth":280}},"expect":[{"path":"selected","op":"equals","value":["home-browsers-tab"]},{"path":"panels","op":"equals","value":["home-browsers"]},{"path":"labels","op":"equals","value":["浏览器管理","账号管理","插件管理","自动化"]},{"path":"personalAtBottom","op":"equals","value":true},{"path":"personalAvatarVisible","op":"equals","value":true},{"path":"personalName","op":"equals","value":"未登录"},{"path":"menuLeftOfContent","op":"equals","value":true},{"path":"browserHeaderSimplified","op":"equals","value":true},{"path":"createSharesDefaultsRow","op":"equals","value":true},{"path":"reservedSidebarWidth","op":"equals","value":280}]},
    {"id":"background","use":"inspectBackground","args":{},"expect":[{"path":"visible","op":"equals","value":true}]},
    {"id":"noAccountRequest","use":"inspectAccountRequests","args":{"count":0},"expect":[{"path":"count","op":"equals","value":0}]},
    {"id":"selectAccounts","use":"click","args":{"target":"accounts"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"accounts","use":"inspect","args":{"ready":{}},"expect":[{"path":"selected","op":"equals","value":["home-accounts-tab"]},{"path":"panels","op":"equals","value":["home-accounts"]},{"path":"linkedAccountsRemoved","op":"equals","value":true}]},
    {"id":"navigateUp","use":"key","args":{"target":"accounts","key":"ArrowUp"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"browsersAfterUp","use":"inspect","args":{"ready":{}},"expect":[{"path":"selected","op":"equals","value":["home-browsers-tab"]},{"path":"panels","op":"equals","value":["home-browsers"]},{"path":"focused","op":"equals","value":"home-browsers-tab"}]},
    {"id":"openSites","use":"click","args":{"target":"openSites"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"editorOpen","use":"inspect","args":{"ready":{"focused":"site-data-search","siteCount":2}},"expect":[{"path":"selected","op":"equals","value":["home-browsers-tab"]},{"path":"panels","op":"equals","value":["home-browsers"]},{"path":"editorVisible","op":"equals","value":true},{"path":"editorHasRecord","op":"equals","value":true},{"path":"focused","op":"equals","value":"site-data-search"}]},
    {"id":"filterSites","use":"filterSites","args":{"text":"BETA"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"filteredSites","use":"inspect","args":{"ready":{"siteCount":1}},"expect":[{"path":"siteHost","op":"equals","value":"beta.test"}]},
    {"id":"chooseDestination","use":"click","args":{"target":"migrateSite"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"previewMigration","use":"inspect","args":{"ready":{"previewReady":true}},"expect":[{"path":"siteHost","op":"equals","value":"beta.test"}]},
    {"id":"applyMigration","use":"click","args":{"target":"applyMigration"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"migrationSaved","use":"inspect","args":{"ready":{"migrationStatus":"已核对「Fixture browser 1」中 beta.test 的 1 条站点偏好"}},"expect":[{"path":"previewReady","op":"equals","value":false}]},
    {"id":"chooseDatabaseDestination","use":"click","args":{"target":"copyDatabase"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"previewDatabase","use":"inspect","args":{"ready":{"previewReady":true}},"expect":[{"path":"migrationPreview","op":"includes","value":"https://beta.test\nhttps://beta.test:8443"}]},
    {"id":"applyDatabase","use":"click","args":{"target":"applyMigration"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"databaseSaved","use":"inspect","args":{"ready":{"migrationStatus":"已将 beta.test 的 2 个 IndexedDB 来源地址复制到「Fixture browser 1」"}},"expect":[{"path":"previewReady","op":"equals","value":false}]},
    {"id":"noMatch","use":"filterSites","args":{"text":"unmatched"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"emptySearch","use":"inspect","args":{"ready":{"siteCount":0}},"expect":[{"path":"siteHost","op":"equals","value":"网站详情"}]},
    {"id":"closeSites","use":"click","args":{"target":"closeSites"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"editorClosed","use":"inspect","args":{"ready":{"sitesButtonFocused":true}},"expect":[{"path":"selected","op":"equals","value":["home-browsers-tab"]},{"path":"panels","op":"equals","value":["home-browsers"]},{"path":"editorVisible","op":"equals","value":false},{"path":"sitesButtonFocused","op":"equals","value":true}]},
    {"id":"selectPersonal","use":"click","args":{"target":"personal"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"personal","use":"inspect","args":{"ready":{}},"expect":[{"path":"selected","op":"equals","value":["home-personal-tab"]},{"path":"panels","op":"equals","value":["home-personal"]},{"path":"personalVisible","op":"equals","value":true},{"path":"legacyAccountButtonRemoved","op":"equals","value":true}]},
    {"id":"accountRequest","use":"inspectAccountRequests","args":{"count":0},"expect":[{"path":"count","op":"equals","value":0}]},
    {"id":"selectPlugins","use":"click","args":{"target":"plugins"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"plugins","use":"inspect","args":{"ready":{}},"expect":[{"path":"selected","op":"equals","value":["home-plugins-tab"]},{"path":"panels","op":"equals","value":["home-plugins"]},{"path":"pluginsVisible","op":"equals","value":true},{"path":"menuLeftOfContent","op":"equals","value":true}]},
    {"id":"returnBrowsers","use":"click","args":{"target":"browsers"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"returned","use":"inspect","args":{"ready":{}},"expect":[{"path":"selected","op":"equals","value":["home-browsers-tab"]},{"path":"panels","op":"equals","value":["home-browsers"]}]},
    {"id":"selectAutomation","use":"click","args":{"target":"automation"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"automation","use":"inspect","args":{"ready":{}},"expect":[{"path":"selected","op":"equals","value":["home-automation-tab"]},{"path":"panels","op":"equals","value":["home-automation"]}]},
    {"id":"createAutomation","use":"click","args":{"target":"createAutomation"},"expect":[{"path":"sent","op":"equals","value":true}]},
    {"id":"automationEditor","use":"inspect","args":{"ready":{"automationEditorVisible":true}},"expect":[{"path":"automationNodeCount","op":"equals","value":1}]},
    {"id":"closeAutomationEditor","use":"click","args":{"target":"closeAutomationEditor"},"expect":[{"path":"sent","op":"equals","value":true}]}
  ]
}
