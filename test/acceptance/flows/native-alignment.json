{
  "schemaVersion": 1,
  "domain": "native-browser",
  "id": "native-alignment",
  "steps": [
    {"id": "acquire", "use": "browser_control", "args": {"action": "acquire"}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "navigate", "use": "browser_tab", "args": {"action": "navigate", "url": {"$ref": "input.firstUrl"}}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "reacquire", "use": "browser_control", "args": {"action": "acquire"}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "listed", "use": "browser_tab", "args": {"action": "list"}, "expect": [{"path": "tabs", "op": "truthy", "value": true}]},
    {"id": "ready", "use": "browser_wait", "args": {"condition": "visible", "selector": "#secret", "timeout_ms": 10000}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "waitSafety", "use": "observationEvidence", "args": {"observation": {"$ref": "ready"}, "forbiddenText": "must-not-leak"}, "expect": [{"path": "passwordSafe", "op": "equals", "value": true}]},
    {"id": "observed", "use": "browser_observe", "args": {"limit": 20, "mark": false, "include_accessibility_tree": true, "include_screenshot": true}, "expect": [{"path": "observationId", "op": "truthy", "value": true}]},
    {"id": "observationContract", "use": "observationEvidence", "args": {"observation": {"$ref": "observed"}, "forbiddenText": "must-not-leak"}, "expect": [{"path": "ax", "op": "equals", "value": true}, {"path": "png", "op": "equals", "value": true}, {"path": "passwordSafe", "op": "equals", "value": true}, {"path": "checkedTrue", "op": "equals", "value": true}, {"path": "checkedFalse", "op": "equals", "value": true}]},
    {"id": "password", "use": "findObserved", "args": {"observation": {"$ref": "observed"}, "selector": "#secret"}, "expect": [{"path": "ref", "op": "truthy", "value": true}]},
    {"id": "checked", "use": "findObserved", "args": {"observation": {"$ref": "observed"}, "selector": "#yes"}, "expect": [{"path": "checked", "op": "equals", "value": true}]},
    {"id": "unchecked", "use": "findObserved", "args": {"observation": {"$ref": "observed"}, "selector": "#no"}, "expect": [{"path": "checked", "op": "equals", "value": false}]},
    {"id": "button", "use": "findObserved", "args": {"observation": {"$ref": "observed"}, "selector": "#go"}, "expect": [{"path": "ref", "op": "truthy", "value": true}]},
    {"id": "click", "use": "browser_action", "args": {"action": "click", "ref": {"$ref": "button.ref"}, "observation_id": {"$ref": "observed.observationId"}, "after": "observe", "observation_options": {"include_accessibility_tree": true, "include_screenshot": true}}, "expect": [{"path": "actionExecuted", "op": "equals", "value": true}, {"path": "observation.observationId", "op": "truthy", "value": true}]},
    {"id": "clickReadback", "use": "inspectState", "args": {"probes": [{"name": "clicks", "selector": "#click-count", "read": "text"}, {"name": "trusted", "selector": "#go", "read": "attribute", "attribute": "data-state"}]}, "expect": [{"path": "values.clicks.value", "op": "equals", "value": "1"}, {"path": "values.trusted.value", "op": "equals", "value": "true"}]},
    {"id": "clicked", "use": "browser_observe", "args": {"keyword": "CLICKED", "limit": 10, "mark": false}, "expect": [{"path": "title", "op": "equals", "value": "CLICKED"}]},
    {"id": "textInput", "use": "browser_observe", "args": {"filter": "input", "limit": 10, "mark": false}, "expect": [{"path": "observationId", "op": "truthy", "value": true}]},
    {"id": "nameTarget", "use": "findObserved", "args": {"observation": {"$ref": "textInput"}, "selector": "#name"}, "expect": [{"path": "ref", "op": "truthy", "value": true}]},
    {"id": "type", "use": "browser_action", "args": {"action": "type", "ref": {"$ref": "nameTarget.ref"}, "observation_id": {"$ref": "textInput.observationId"}, "text": {"$ref": "input.text"}}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "editReadback", "use": "inspectState", "args": {"probes": [{"name": "name", "selector": "#name", "read": "value"}]}, "expect": [{"path": "values.name.value", "op": "equals", "value": {"$ref": "input.text"}}]},
    {"id": "edited", "use": "browser_observe", "args": {"filter": "input", "limit": 10, "mark": false}, "expect": [{"path": "observationId", "op": "truthy", "value": true}]},
    {"id": "editedInput", "use": "findObserved", "args": {"observation": {"$ref": "edited"}, "selector": "#name"}, "expect": [{"path": "value", "op": "equals", "value": {"$ref": "input.text"}}]},
    {"id": "replace", "use": "browser_tab", "args": {"action": "replace", "url": {"$ref": "input.secondUrl"}}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "acquireBack", "use": "browser_control", "args": {"action": "acquire"}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "back", "use": "browser_tab", "args": {"action": "back"}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "acquireBackWait", "use": "browser_control", "args": {"action": "acquire"}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "backWait", "use": "browser_wait", "args": {"condition": "url_matches", "value": "/one", "timeout_ms": 5000}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "forward", "use": "browser_tab", "args": {"action": "forward"}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "acquireForwardWait", "use": "browser_control", "args": {"action": "acquire"}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "forwardWait", "use": "browser_wait", "args": {"condition": "url_matches", "value": "/two", "timeout_ms": 5000}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "stale", "use": "browser_action", "args": {"action": "click", "ref": {"$ref": "nameTarget.ref"}, "observation_id": {"$ref": "textInput.observationId"}}, "expect": [{"path": "errorCode", "op": "oneOf", "value": ["OBSERVATION_MISMATCH", "OBSERVED_REF_EXPIRED"]}]},
    {"id": "tabs", "use": "browser_tab", "args": {"action": "list"}, "expect": [{"path": "tabs", "op": "truthy", "value": true}]},
    {"id": "targets", "use": "tabTargets", "args": {"listing": {"$ref": "tabs"}}, "expect": [{"path": "target", "op": "exists", "value": true}, {"path": "other", "op": "exists", "value": true}]},
    {"id": "switch", "use": "browser_tab", "args": {"action": "switch", "tab_id": {"$ref": "targets.other"}}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "acquireClose", "use": "browser_control", "args": {"action": "acquire"}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "close", "use": "browser_tab", "args": {"action": "close", "tab_id": {"$ref": "targets.target"}}, "expect": [{"path": "success", "op": "equals", "value": true}]},
    {"id": "tabsReadback", "use": "inspectTabs", "args": {}, "expect": [{"path": "tabs.length", "op": "equals", "value": {"$ref": "targets.countAfterClose"}}]}
  ]
}
